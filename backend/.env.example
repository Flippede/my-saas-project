# Backend runtime configuration.
# The deployed systemd service reads backend/.env via EnvironmentFile.

# General backend settings
DB_PATH=x_creator.db
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://x-creator.cc

# WeChat Official Account login
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=

# Admin access control
# Comma-separated WeChat openids allowed to access /api/v1/admin/* endpoints.
ADMIN_OPENIDS=

# WeChat Pay Native V3 - create Native QR order
FIXED_AMOUNT=49.00
WECHAT_API_BASE=https://api.mch.weixin.qq.com
WECHAT_NOTIFY_URL=https://x-creator.cc/api/v1/wechat/webhook
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/www/wwwroot/x-creator.cc/certs/apiclient_key.pem

# PEM values can be stored on one line with \n between lines.
# Prefer WECHAT_PRIVATE_KEY_PATH. Do not commit real keys or certificates.
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_MERCHANT_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# WeChat Pay callback verification/decryption
WECHAT_V3_KEY=
WECHAT_PLATFORM_PUBLIC_KEY_PATH=/www/wwwroot/x-creator.cc/certs/wechatpay_public_key.pem
WECHAT_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_WECHAT_PAY_PLATFORM_PUBLIC_KEY\n-----END PUBLIC KEY-----"

# Supported legacy aliases:
# WECHAT_APPID: WECHAT_PAY_APPID, WX_APPID, APPID, WECHAT_MP_APPID
# WECHAT_MCHID: WECHAT_PAY_MCHID, WX_MCHID, MCH_ID, MCHID
# WECHAT_V3_KEY: WECHAT_API_V3_KEY, WECHAT_PAY_V3_KEY, WX_API_V3_KEY, API_V3_KEY
# WECHAT_CERT_SERIAL_NO: WECHAT_PAY_CERT_SERIAL_NO, WX_CERT_SERIAL_NO, MCH_CERT_SERIAL_NO
# WECHAT_PRIVATE_KEY_PATH: WECHAT_PAY_PRIVATE_KEY_PATH
# WECHAT_PRIVATE_KEY: WECHAT_PAY_PRIVATE_KEY, WX_PRIVATE_KEY, MCH_PRIVATE_KEY
# WECHAT_PLATFORM_PUBLIC_KEY_PATH: WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH
# WECHAT_PLATFORM_PUBLIC_KEY: WECHAT_PAY_PLATFORM_PUBLIC_KEY, WX_PLATFORM_PUBLIC_KEY

# AI tool provider
DEEPSEEK_API_KEY=

# AI game world generator
AI_GAME_PROVIDER=mock
AI_GAME_MODEL=
